# Optional: bake your Supabase project into the build so teammates skip the setup screen.
# Copy this file to .env and fill it in. The anon / publishable key is safe to ship in an app.
# NEVER put the service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
